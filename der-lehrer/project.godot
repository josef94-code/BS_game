; Godot-Projektdatei – DER LEHRER (Lincoln High)

config_version=5

[application]

config/name="Der Lehrer - Lincoln High"
config/description="3D-Lernspiel für Mechatroniker/-innen, 10. Jahrgangsstufe"
config/version="0.7.0"
run/main_scene="res://szenen/hauptmenue.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.06, 0.04, 0.05, 1)
boot_splash/show_image=false

[autoload]

Daten="*res://skripte/autoload/daten.gd"
Spielstand="*res://skripte/autoload/spielstand.gd"
Audio="*res://skripte/autoload/audio.gd"
Grafik="*res://skripte/autoload/grafik.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_antialiasing=1

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/positional_shadow/atlas_size=4096

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
textures/vram_compression/import_etc2_astc=true
